# Copy this file to ".env" and fill in your own values:
#
#     cp .env.example .env
#
# ".env" is listed in .gitignore, so your API key and password never get committed.

# --- OpenAI -----------------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Any chat model that supports Structured Outputs works (gpt-4o and newer).
OPENAI_MODEL=gpt-6-luna

# Only used by categorize_feedback_themes.py
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- File paths -------------------------------------------------------------
# Relative paths are resolved from the repo root. Absolute paths and "~" work too.
INPUT_CSV_PATH=data/sample_restaurant_feedback.csv
OUTPUT_DIR=output

# --- PostgreSQL -------------------------------------------------------------
# Only used by the analyze_*.py scripts.
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
